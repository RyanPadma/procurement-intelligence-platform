table ml_savings_opportunity
	lineageTag: ec4f8fd8-dc31-4814-b1b3-91b8a5607b28
	sourceLineageTag: [dbo].[ml_savings_opportunity]

	measure 'Latest Savings Opportunity Prediction Date' =
			
			CALCULATE (
			    MAX (
			        ml_savings_opportunity[PredictionDate]
			    ),
			    REMOVEFILTERS (
			        ml_savings_opportunity
			    ),
			    REMOVEFILTERS (
			        dim_supplier
			    ),
			    REMOVEFILTERS (
			        dim_category
			    )
			)
		formatString: General Date
		displayFolder: 07 Savings Opportunity
		lineageTag: 83c11fd4-fc99-4da8-9c8b-837804a7d7ed

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Savings Opportunities' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        COUNTROWS (
			            ml_savings_opportunity
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate
			    )
		formatString: #,0
		displayFolder: 07 Savings Opportunity
		lineageTag: f8b0dd74-739b-4e87-8193-9b0974241372

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Positive Savings Opportunities' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        COUNTROWS (
			            ml_savings_opportunity
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate,
			        ml_savings_opportunity[PotentialAnnualSavingsEUR] > 0
			    )
		formatString: #,0
		displayFolder: 07 Savings Opportunity
		lineageTag: 2a9ab71e-807b-4b68-8377-c8afeca56493

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Actionable Savings Opportunities' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        COUNTROWS (
			            ml_savings_opportunity
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate,
			        ml_savings_opportunity[ActionableOpportunityFlag] = 1
			    )
		formatString: 0
		displayFolder: 07 Savings Opportunity
		lineageTag: 08d7fbb1-6cd2-4494-b3ac-0ac80d0e8cf0

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Potential Annual Savings' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        SUM (
			            ml_savings_opportunity[PotentialAnnualSavingsEUR]
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 07 Savings Opportunity
		lineageTag: 501cf0cb-50f8-4012-a994-c5421470428e

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Actionable Potential Annual Savings' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        SUM (
			            ml_savings_opportunity[PotentialAnnualSavingsEUR]
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate,
			        ml_savings_opportunity[ActionableOpportunityFlag] = 1
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 07 Savings Opportunity
		lineageTag: 954abfd6-91d5-4418-8a3e-ff60ae9331c0

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Actionable Opportunity %' =
			
			DIVIDE (
			    [Actionable Savings Opportunities],
			    [Savings Opportunities]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 Savings Opportunity
		lineageTag: 5202b705-6241-4951-b11f-abe8e8af2b66

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Opportunity Annualized Spend' =
			
			VAR LatestDate =
			    [Latest Savings Opportunity Prediction Date]
			RETURN
			    CALCULATE (
			        SUM (
			            ml_savings_opportunity[AnnualizedEligibleSpendEUR]
			        ),
			        ml_savings_opportunity[PredictionDate] = LatestDate
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 07 Savings Opportunity
		lineageTag: f17bd6ab-414f-4487-bb2f-0e1b3c1b74e3

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Savings Potential %' =
			
			DIVIDE (
			    [Potential Annual Savings],
			    [Opportunity Annualized Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 07 Savings Opportunity
		lineageTag: 79fe904e-d599-4b52-aab3-a596d3ca7c65

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

