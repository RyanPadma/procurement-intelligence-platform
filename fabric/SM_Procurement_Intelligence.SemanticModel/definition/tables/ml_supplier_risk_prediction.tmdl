table ml_supplier_risk_prediction
	lineageTag: 9e99e2b2-2dac-46b5-a981-ff080214932d
	sourceLineageTag: [dbo].[ml_supplier_risk_prediction]

	measure 'Latest Supplier Risk Prediction Date' =
			
			CALCULATE (
			    MAX (
			        ml_supplier_risk_prediction[PredictionDate]
			    ),
			    REMOVEFILTERS (
			        dim_supplier
			    ),
			    REMOVEFILTERS (
			        ml_supplier_risk_prediction
			    )
			)
		formatString: General Date
		isHidden
		displayFolder: 05 Supplier Risk
		lineageTag: 815a134d-8b99-4345-8d60-347cbdc7eaf0

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = IsHidden

	measure 'Suppliers Scored' =
			
			VAR LatestDate =
			    [Latest Supplier Risk Prediction Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT (
			            ml_supplier_risk_prediction[SupplierID]
			        ),
			        ml_supplier_risk_prediction[PredictionDate] = LatestDate
			    )
		formatString: #,0.0
		displayFolder: 05 Supplier Risk
		lineageTag: 6a130662-e8b1-400b-9b25-1b62bd9acbcf

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average Supplier Risk Score' =
			
			VAR LatestDate =
			    [Latest Supplier Risk Prediction Date]
			RETURN
			    CALCULATE (
			        AVERAGE (
			            ml_supplier_risk_prediction[SupplierRiskScore]
			        ),
			        ml_supplier_risk_prediction[PredictionDate] = LatestDate
			    )
		formatString: 0.00
		displayFolder: 05 Supplier Risk
		lineageTag: 4d4f8bf0-c342-44c3-bdd7-9345e2db15aa

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'High-Risk Suppliers' =
			
			VAR LatestDate =
			    [Latest Supplier Risk Prediction Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT (
			            ml_supplier_risk_prediction[SupplierID]
			        ),
			        ml_supplier_risk_prediction[PredictionDate] = LatestDate,
			        ml_supplier_risk_prediction[PredictedHighRiskFlag] = 1
			    )
		formatString: 0
		displayFolder: 05 Supplier Risk
		lineageTag: 4d924959-92c1-44ec-ac9b-c024a58cd573

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'High-Risk Supplier %' =
			
			DIVIDE (
			    [High-Risk Suppliers],
			    [Suppliers Scored]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Supplier Risk
		lineageTag: 7d75229e-96f2-473b-adf1-02557498b59c

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Spend with High-Risk Suppliers' =
			
			VAR LatestDate =
			    [Latest Supplier Risk Prediction Date]
			
			VAR HighRiskSupplierSet =
			    CALCULATETABLE (
			        VALUES (
			            ml_supplier_risk_prediction[SupplierID]
			        ),
			        ml_supplier_risk_prediction[PredictionDate] = LatestDate,
			        ml_supplier_risk_prediction[PredictedHighRiskFlag] = 1
			    )
			
			RETURN
			    CALCULATE (
			        [Total Eligible Spend],
			        TREATAS (
			            HighRiskSupplierSet,
			            dim_supplier[SupplierID]
			        )
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 05 Supplier Risk
		lineageTag: 17a1c52a-cdfd-41ed-a57e-0677f1b2edb0

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Spend with High-Risk Suppliers %' =
			
			DIVIDE (
			    [Spend with High-Risk Suppliers],
			    [Total Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Supplier Risk
		lineageTag: 9e23f0b3-6c4b-48a7-8f79-4dd674228f58

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

