table ml_pricing_anomaly_prediction
	lineageTag: 076aead4-2a7b-4293-a9f1-b554c7d00b54
	sourceLineageTag: [dbo].[ml_pricing_anomaly_prediction]

	measure 'Latest Pricing Anomaly Prediction Date' =
			
			CALCULATE (
			    MAX (
			        ml_pricing_anomaly_prediction[PredictionDate]
			    ),
			    REMOVEFILTERS ()
			)
		formatString: General Date
		displayFolder: 06 Pricing Anomaly
		lineageTag: 3f64b065-a785-4b59-8346-37b8b522ba40

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Pricing Items Scored' =
			
			VAR LatestDate =
			    [Latest Pricing Anomaly Prediction Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT (
			            ml_pricing_anomaly_prediction[POItemID]
			        ),
			        ml_pricing_anomaly_prediction[PredictionDate] = LatestDate
			    )
		formatString: #,0
		displayFolder: 06 Pricing Anomaly
		lineageTag: 3adafc0b-8040-4ca2-a4a8-83a4dc9fbf40

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Pricing Anomalies' =
			
			VAR LatestDate =
			    [Latest Pricing Anomaly Prediction Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT (
			            ml_pricing_anomaly_prediction[POItemID]
			        ),
			        ml_pricing_anomaly_prediction[PredictionDate] = LatestDate,
			        ml_pricing_anomaly_prediction[PricingAnomalyFlag] = 1
			    )
		formatString: #,0
		displayFolder: 06 Pricing Anomaly
		lineageTag: 7bbc2e4a-600f-424c-95df-d1acb42c401e

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Pricing Anomaly Rate' =
			
			DIVIDE (
			    [Pricing Anomalies],
			    [Pricing Items Scored]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 Pricing Anomaly
		lineageTag: 36c00b97-45fe-4a9e-bb37-7af36d3362ca

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Eligible Spend with Pricing Anomalies' =
			
			VAR LatestDate =
			    [Latest Pricing Anomaly Prediction Date]
			
			VAR AnomalousPOItems =
			    CALCULATETABLE (
			        VALUES (
			            ml_pricing_anomaly_prediction[PurchaseOrderFactKey]
			        ),
			        ml_pricing_anomaly_prediction[PredictionDate] = LatestDate,
			        ml_pricing_anomaly_prediction[PricingAnomalyFlag] = 1
			    )
			
			RETURN
			    CALCULATE (
			        [Total Eligible Spend],
			        TREATAS (
			            AnomalousPOItems,
			            fact_purchase_order[PurchaseOrderFactKey]
			        )
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 06 Pricing Anomaly
		lineageTag: 64a66613-e949-4e8f-a427-6f598f0d0a4e

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Eligible Spend with Pricing Anomalies %' =
			
			DIVIDE (
			    [Eligible Spend with Pricing Anomalies],
			    [Total Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 Pricing Anomaly
		lineageTag: b4505571-4026-4bfe-b7d9-5e30dadecc09

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average Pricing Anomaly Score' =
			
			VAR LatestDate =
			    [Latest Pricing Anomaly Prediction Date]
			RETURN
			    CALCULATE (
			        AVERAGE (
			            ml_pricing_anomaly_prediction[PricingAnomalyScore]
			        ),
			        ml_pricing_anomaly_prediction[PredictionDate] = LatestDate
			    )
		displayFolder: 06 Pricing Anomaly
		lineageTag: 4c09d6c6-82e7-456a-aa39-4c3f161d4cc2

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

