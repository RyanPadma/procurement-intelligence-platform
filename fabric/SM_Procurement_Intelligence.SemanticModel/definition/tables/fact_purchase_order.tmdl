table fact_purchase_order
	lineageTag: 7ff026fe-9003-4d76-8dd5-f9c22439fc93
	sourceLineageTag: [dbo].[fact_purchase_order]

	measure 'Total Eligible Spend' =
			
			SUM (
			    fact_purchase_order[EligibleSpendEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: fe2a1e86-58d8-4a5e-a99b-bc32e78e3072

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Contract Compliant Spend' =
			
			SUM (
			    fact_purchase_order[ContractCompliantSpendEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: fe420f3f-4792-4409-baed-6fb27130007d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Maverick Spend' =
			
			SUM (
			    fact_purchase_order[MaverickSpendEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: f56204ea-97e3-4872-aef3-757b7ccc9abf

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Contract Compliance %' =
			
			DIVIDE (
			    [Contract Compliant Spend],
			    [Total Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Spend & Compliance
		lineageTag: 3d1ba3ea-4831-4f39-977e-b4e716e9239a

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Maverick Spend %' =
			
			DIVIDE (
			    [Maverick Spend],
			    [Total Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Spend & Compliance
		lineageTag: aed6e689-c8df-41ad-805e-580be06eafa3

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Purchase Orders' =
			
			DISTINCTCOUNT (
			    fact_purchase_order[POID]
			)
		formatString: #,0
		displayFolder: 01 Spend & Compliance
		lineageTag: b3b01ed2-fb49-40de-8b05-648aad0aa93c

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'PO Items' =
			
			DISTINCTCOUNT (
			    fact_purchase_order[POItemID]
			)
		formatString: #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: 5ab15d75-4c59-4af3-93a4-a44ebf7f9427

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average Eligible Spend per PO' =
			
			DIVIDE (
			    [Total Eligible Spend],
			    [Purchase Orders]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: 136ac164-2ef6-4855-b8c5-e52fb0151e7c

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Spend Compliance Reconciliation' =
			
			[Total Eligible Spend]
			    - [Contract Compliant Spend]
			    - [Maverick Spend]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 01 Spend & Compliance
		lineageTag: 1191be35-2da3-476d-9151-7756aa8fe74e

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Spend Compliance Reconciliation %' =
			
			DIVIDE (
			    [Spend Compliance Reconciliation],
			    [Total Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Spend & Compliance
		lineageTag: 3d635fbf-93fa-40c2-a39d-296e597f45be

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

