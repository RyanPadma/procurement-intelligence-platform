table fact_invoice
	lineageTag: 3ab5f7b7-3882-443d-b416-ef7110e9eb26
	sourceLineageTag: [dbo].[fact_invoice]

	measure Invoices =
			
			DISTINCTCOUNT (
			    fact_invoice[InvoiceID]
			)
		formatString: #,0
		displayFolder: 03 Invoice & Matching
		lineageTag: dba06f24-af7a-49ce-b81e-86223f6ecce1

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Invoice Items' =
			
			DISTINCTCOUNT (
			    fact_invoice[InvoiceItemID]
			)
		formatString: 0
		displayFolder: 03 Invoice & Matching
		lineageTag: 22fd04cb-16aa-4a9f-b0fe-3ef3c6f15f72

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Gross Invoice Amount' =
			
			SUM (
			    fact_invoice[GrossAmountEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 03 Invoice & Matching
		lineageTag: 674812cd-fd15-4ceb-9dc1-3c2f4f1e9bf3

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Invoice Three-Way Matched Items' =
			
			CALCULATE (
			    [Invoice Items],
			    fact_invoice[ThreeWayMatchFlag] = TRUE ()
			)
		formatString: 0
		displayFolder: 03 Invoice & Matching
		lineageTag: 5e7b5f03-3bb4-4f44-9dac-6a1180f69439

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Invoice Three-Way Match %' =
			
			DIVIDE (
			    [Invoice Three-Way Matched Items],
			    [Invoice Items]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Invoice & Matching
		lineageTag: 585d54a5-072b-4c87-a928-0b517c00f164

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Invoice Exception Items - Detail' =
			
			CALCULATE (
			    [Invoice Items],
			    fact_invoice[ThreeWayMatchFlag] = FALSE ()
			)
		formatString: 0
		displayFolder: 03 Invoice & Matching
		lineageTag: b12e29cf-0550-4890-b147-2b7a92ed5f69

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Invoice Exception % - Detail' =
			
			DIVIDE (
			    [Invoice Exception Items - Detail],
			    [Invoice Items]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Invoice & Matching
		lineageTag: 1978a52e-8166-41b4-a4e6-11a581a59231

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Invoice Exception Amount' =
			
			SUM (
			    fact_invoice[InvoiceExceptionAmountEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 03 Invoice & Matching
		lineageTag: ce614c76-233d-4949-89a4-82ec044bc2c2

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Invoice Exception Amount %' =
			
			DIVIDE (
			    [Invoice Exception Amount],
			    [Gross Invoice Amount]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Invoice & Matching
		lineageTag: 27e8f999-1469-4770-a7c7-541ca0719546

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Invoice Disputed Invoices' =
			
			CALCULATE (
			    DISTINCTCOUNT (
			        fact_invoice[InvoiceID]
			    ),
			    fact_invoice[DisputeFlag] = TRUE ()
			)
		formatString: #,0
		displayFolder: 03 Invoice & Matching
		lineageTag: 9d843472-5a81-422d-9174-74cfc4f0980e

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Invoice Dispute % - Detail' =
			
			DIVIDE (
			    [Invoice Disputed Invoices],
			    [Invoices]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Invoice & Matching
		lineageTag: 462e426f-3452-4500-a11b-658db247fd37

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

