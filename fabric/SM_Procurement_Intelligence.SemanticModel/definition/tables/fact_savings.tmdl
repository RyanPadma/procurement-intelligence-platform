table fact_savings
	lineageTag: 9ecf9828-bb4d-44d6-af8d-8af7da5911ba
	sourceLineageTag: [dbo].[fact_savings]

	measure 'Savings Projects' =
			
			DISTINCTCOUNT (
			    fact_savings[SavingsProjectID]
			)
		formatString: #,0
		displayFolder: 04 Savings Pipeline
		lineageTag: 392bae27-630f-442b-9a61-7208e5a1215a

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Active Savings Projects' =
			
			CALCULATE (
			    [Savings Projects],
			    fact_savings[ActivePipelineFlag] = TRUE ()
			)
		formatString: #,0
		displayFolder: 04 Savings Pipeline
		lineageTag: da71c514-8abf-4ef0-9f64-4ee1f80dff81

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Forecasted Savings' =
			
			SUM (
			    fact_savings[ForecastedSavingsEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 04 Savings Pipeline
		lineageTag: 30070743-0dd6-4c2c-9644-ce177c5f3ebb

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Weighted Forecast Savings' =
			
			SUM (
			    fact_savings[WeightedForecastSavingsEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 04 Savings Pipeline
		lineageTag: 05d98133-8d32-400f-bbcc-4a7d442f169b

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Approved Savings' =
			
			SUM (
			    fact_savings[ApprovedSavingsEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 04 Savings Pipeline
		lineageTag: 72ead696-ccc5-45a6-86b5-dd189eb82052

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Realized Savings' =
			
			CALCULATE (
			    SUM (
			        fact_savings[RealizedSavingsEUR]
			    ),
			    USERELATIONSHIP (
			        fact_savings[ActualCompletionDateKey],
			        dim_date[DateKey]
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 04 Savings Pipeline
		lineageTag: e9801d78-fa6d-45b3-b556-d88de7a17b29

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Savings Realization %' =
			
			DIVIDE (
			    [Realized Savings],
			    [Approved Savings]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Savings Pipeline
		lineageTag: c23a1f0d-fc9d-43a2-8e9e-b73cd3bb8593

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

