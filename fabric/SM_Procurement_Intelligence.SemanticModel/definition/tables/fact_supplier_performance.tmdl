		displayFolder: 02 Supplier Performance
		lineageTag: 665934a5-3c5d-4362-ad3a-048926073f66

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Supplier Quality Index' =
			
			DIVIDE (
			    [Dispute-Free Invoices],
			    [Supplier Invoice Count]
			)
		formatString: 0%;-0%;0%
		displayFolder: 02 Supplier Performance
		lineageTag: 51ebd452-cc37-48e4-b5de-3bb316269711

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Three-Way Matched Invoice Items' =
			
