table fact_supplier_performance
	lineageTag: f57363e1-b999-4579-a1d5-4bad4b1fc295
	sourceLineageTag: [dbo].[fact_supplier_performance]

	measure 'Suppliers with Performance' =
			
			DISTINCTCOUNT (
			    fact_supplier_performance[SupplierID]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: 3e994b37-88e7-42df-a80e-eaec6354d430

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Fully Received PO Items' =
			
			SUM (
			    fact_supplier_performance[FullyReceivedPOItemCount]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: e4e076d4-8985-466f-abfc-5d9ab3444e54

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'On-Time Fully Received PO Items' =
			
			SUM (
			    fact_supplier_performance[OnTimeFullyReceivedPOItemCount]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: a9860b31-b7f2-4f5a-9b5a-b824388bbfe5

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Supplier OTD %' =
			
			DIVIDE (
			    [On-Time Fully Received PO Items],
			    [Fully Received PO Items]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Supplier Performance
		lineageTag: 209680b5-cf45-41aa-84ee-898522322fcb

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Overdue Open Deliveries' =
			
			SUM (
			    fact_supplier_performance[OverdueOpenDeliveryCount]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: 3f0e0dd3-c21f-4fa1-a157-db9da8434860

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Overdue Open Delivery %' =
			
			DIVIDE (
			    [Overdue Open Deliveries],
			    [Fully Received PO Items]
			        + [Overdue Open Deliveries]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Supplier Performance
		lineageTag: 4c89068b-8207-4883-a0f5-2c6af9435be7

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Supplier Invoice Count' =
			
			SUM (
			    fact_supplier_performance[InvoiceCount]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: ffcd8531-4b09-41c9-9f1e-8900804f80a1

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Disputed Invoices' =
			
			SUM (
			    fact_supplier_performance[DisputedInvoiceCount]
			)
		formatString: #,0
		displayFolder: 02 Supplier Performance
		lineageTag: 389b963e-033e-4a13-a73b-ae6b735755fa

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Invoice Dispute %' =
			
			DIVIDE (
			    [Disputed Invoices],
			    [Supplier Invoice Count]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Supplier Performance
		lineageTag: 58c19351-f2c9-485f-8f17-7db6687a412a

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Dispute-Free Invoices' =
			
