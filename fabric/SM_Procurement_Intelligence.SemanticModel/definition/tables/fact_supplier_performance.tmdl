	measure 'Supplier Performance Eligible Spend' =
			
			SUM (
			    fact_supplier_performance[EligibleSpendEUR]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 02 Supplier Performance
		lineageTag: f205f74a-10a7-4939-a5d4-fdd55f6f7c61

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Supplier Performance Maverick %' =
			
			DIVIDE (
			    SUM (
			        fact_supplier_performance[MaverickSpendEUR]
			    ),
			    [Supplier Performance Eligible Spend]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Supplier Performance
		lineageTag: a27eeb85-c557-478b-b1d5-e28ae826a00f

